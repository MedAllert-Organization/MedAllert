generator client {
  provider      = "prisma-client-js"
  output        = "./generated/prisma"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

model Users {
  userId             String              @id @default(cuid()) @map("user_id")
  fullName           String              @map("full_name")
  email              String              @unique
  phone              String
  hash               String
  image              String?
  timezoneId         String?
  timezone           Timezone?           @relation(fields: [timezoneId], references: [id])
  acceptedTosAt      DateTime            @default(now()) @map("accepted_tos_at")
  accountConfirmedAt DateTime?           @default(now()) @map("account_confirmed_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  verificationCodes  VerificationCodes[]
  medications        Medications[]
  treatments         Treatments[]
  sharedTreatments   TreatmentShares[]

  @@map("users")
}

model Timezone {
  id        String  @id @default(cuid())
  name      String  @unique
  label     String
  utcOffset Int
  users     Users[]

  @@map("timezones")
}

model VerificationCodes {
  codeId      String    @id @default(cuid()) @map("code_id")
  userId      String    @map("user_id")
  user        Users     @relation(fields: [userId], references: [userId])
  value       String
  codeType    String    @map("code_type")
  confirmedAt DateTime? @map("confirmed_at")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("verification_codes")
}

model Treatments {
  treatmentId String                @id @default(cuid()) @map("treatment_id")
  userId      String                @map("user_id")
  user        Users                 @relation(fields: [userId], references: [userId])
  name        String
  description String?
  startAt     DateTime              @default(now()) @map("start_at")
  endAt       DateTime?             @map("end_at")
  medications TreatmentMedication[]
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  sharedWith  TreatmentShares[]

  @@map("treatments")
}

model TreatmentMedication {
  id           String @id @default(cuid())
  treatmentId  String @map("treatment_id")
  medicationId String @map("medication_id")

  visualTypeId String?      @unique @map("visual_type_id")
  visualType   VisualTypes? @relation(fields: [visualTypeId], references: [visualId], onDelete: Cascade)

  treatment  Treatments  @relation(fields: [treatmentId], references: [treatmentId])
  medication Medications @relation(fields: [medicationId], references: [medicationId])

  dose                 String
  alertPeriodInMinutes Int
  lastTaken            DateTime? @map("last_taken")
  nextTakeAt           DateTime? @map("next_take_at")
  takenQuantity        Int       @default(0) @map("taken_quantity")
  totalQuantity        Int       @default(0) @map("total_quantity")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([treatmentId, medicationId])
  @@map("treatment_medications")
}

model Medications {
  medicationId String      @id @default(cuid()) @map("medication_id")
  userId       String      @map("user_id")
  user         Users       @relation(fields: [userId], references: [userId])
  name         String
  description  String?
  soundTypeId  String?     @map("sound_type_id")
  soundType    SoundTypes? @relation(fields: [soundTypeId], references: [soundId])

  treatments    TreatmentMedication[]
  notifications Notifications[]
  annotations   Annotations[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("medications")
}

model Notifications {
  notificationId String      @id @default(cuid()) @map("notification_id")
  medicationId   String      @map("medication_id")
  medication     Medications @relation(fields: [medicationId], references: [medicationId])
  name           String
  alertAt        DateTime    @default(now()) @map("alert_at")
  soundId        String      @map("sound_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@map("notifications")
}

model Annotations {
  annotationId String      @id @default(cuid()) @map("annotation_id")
  medicationId String      @map("medication_id")
  medication   Medications @relation(fields: [medicationId], references: [medicationId], onDelete: Cascade)
  content      String
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("annotations")
}

model VisualTypes {
  visualId  String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visualType VisualTypeEnum @default(PILL)
  size       VisualSizeEnum @default(MEDIUM)
  color1     String
  color2     String?
  pattern    VisualPatternEnum @default(SOLID)
  opacity    Float?
  rotation   Int?

  treatmentMedication TreatmentMedication?
}

enum VisualTypeEnum {
  CAPSULE
  PILL
  TABLET
  DROP
  LIQUID
  INHALER
  INJECTION
  OINTMENT
  PATCH
}

enum VisualSizeEnum {
  SMALL
  MEDIUM
  LARGE
}

enum VisualPatternEnum {
  SOLID
  STRIPED
  HALF
  RING
  DOTS
  BAND
  GRADIENT
}

model SoundTypes {
  soundId     String        @id @default(cuid()) @map("sound_id")
  sound       String
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  medications Medications[]

  @@map("sound_types")
}

model TreatmentShares {
  treatmentId String     @map("treatment_id")
  userId      String     @map("user_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  treatment   Treatments @relation(fields: [treatmentId], references: [treatmentId], onDelete: Cascade)
  user        Users      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([treatmentId, userId])
  @@map("treatment_shares")
}

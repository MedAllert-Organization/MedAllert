{
  "name": "medallert-backend",
  "type": "module",
  "private": true,
  "scripts": {
    "db:gen": "rm -rf src/infra/prisma/generate && prisma generate --no-hints --schema=./src/infra/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy",
    "db:setup": "npm run db:gen && npm run db:migrate",
    "dev": "npm run db:setup && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit --strict",
    "format": "npx @biomejs/biome check --write",
    "prepare": "husky install",
    "commit": "git-cz",
    "test": "set NODE_OPTIONS=--experimental-vm-modules && jest",
    "test:watch": "set NODE_OPTIONS=--experimental-vm-modules && jest --watch"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@hono/node-server": "1.19.0",
    "@hono/swagger-ui": "0.5.2",
    "@hono/zod-validator": "^0.4.3",
    "@prisma/client": "^6.19.0",
    "argon2": "0.44.0",
    "date-fns": "^4.1.0",
    "dayjs": "1.11.13",
    "dotenv": "^17.2.3",
    "expo-file-system": "^19.0.20",
    "expo-media-library": "~18.2.1",
    "expo-sharing": "~14.0.8",
    "hono": "^4.9.8",
    "hono-openapi": "0.4.8",
    "install": "0.13.0",
    "pdfkit": "^0.17.2",
    "resend": "6.0.1",
    "try": "1.0.0-beta.10",
    "ts-node": "^10.9.2",
    "zod": "3.25.76",
    "zod-openapi": "4.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "20.11.17",
    "@types/pdfkit": "^0.17.3",
    "commitizen": "^4.3.1",
    "dotenv-cli": "^10.0.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "prisma": "^6.19.0",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.5",
    "typescript": "5.8.3"
  },
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}